PUBLIC_SITE_URL=https://pagero.kr/life
PUBLIC_CONTACT_EMAIL=info@pagero.kr

# AdSense review/ownership verification.
# Leave true while the site is under review. Set false only to remove the
# AdSense verification meta/script entirely.
PUBLIC_ADSENSE_CLIENT=ca-pub-1906196934401001
PUBLIC_ADSENSE_VERIFY_ENABLED=true

# Actual ad units are disabled unless this is explicitly true and slot IDs exist.
PUBLIC_ADSENSE_ADS_ENABLED=false
PUBLIC_AD_SLOT_TOP=
PUBLIC_AD_SLOT_MID=
PUBLIC_AD_SLOT_BOTTOM=

# Coupang Partners desktop/mobile banner codes are installed in
# scripts/inject-coupang-ad.mjs (provided by the publisher on 2026-11-05).

# Adpick Shopping Mate hotdeal member ID. Set on Cloudflare Pages runtime, not in client code.
# This is a publishing affiliate ID, NOT an API secret or password.
ADPICK_AFFID=
